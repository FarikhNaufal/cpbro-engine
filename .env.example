# ==================================================
# cryptobroV3 - Environment Configuration Template
# ==================================================

# APP
APP_ENV=local
APP_VERSION=0.1.0
APP_NAME=cryptobroV3
HTTP_PORT=8080
STORAGE_PATH=storage

# SCANNER
SCAN_ENABLED=true
SCAN_INTERVAL_MODE=m15_close
SCAN_STARTUP_DELAY_SECONDS=5
SCAN_CONTEXT_TIMEOUT_SECONDS=120
PREVENT_SCAN_OVERLAP=true
SCAN_CLOSE_CANDLE_BUFFER_SECONDS=3

# MONITORING
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=60
MONITORING_MAX_HOLD_MINUTES=120
MONITORING_MAX_HOLD_M15_CANDLES=8

# EVALUATION
EVALUATION_ENABLED=true
EVALUATION_AUTO_RUN=false
EVALUATION_AUTO_APPLY=false
EVALUATION_INTERVAL_MINUTES=360
EVALUATION_MIN_SAMPLE_WARNING=10
EVALUATION_MIN_SAMPLE_MEDIUM=20
EVALUATION_MIN_SAMPLE_HIGH=50

# BINANCE READ ONLY (No transaction secrets)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=15
BINANCE_MAX_RETRY=2
BINANCE_RETRY_BACKOFF_MS=300

# AI / GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=25
MAX_AI_CONCURRENCY=2
MAX_AI_CANDIDATES_DEFAULT=3
AI_AUDIT_ENABLED=true

# TELEGRAM
TELEGRAM_ENABLED=false
TELEGRAM_SIGNAL_ENABLED=true
TELEGRAM_STATUS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_STATUS_CHAT_ID=
TELEGRAM_STATUS_ALLOW_SIGNAL_CHAT_FALLBACK=false
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_OPS_BOOT_ENABLED=true
TELEGRAM_OPS_SCAN_ENABLED=false
TELEGRAM_OPS_ADMIN_ENABLED=false

# RUNTIME / WORKER / UNIVERSE / STRATEGY
# Legacy fallback env names are still accepted by the loader, but this example shows canonical names only.
WORKER_MAX_MARKETDATA_CONCURRENCY=10
WORKER_MAX_CANDIDATE_PIPELINE_CONCURRENCY=0
WORKER_MAX_AI_CONCURRENCY=2
WORKER_MAX_MONITORING_CANDLE_CONCURRENCY=4
UNIVERSE_MAX_SYMBOLS_DEFAULT=75
UNIVERSE_TIER_C_MIN_VOLUME=15000000
UNIVERSE_DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
UNIVERSE_TIER_A_MIN_QUOTE_VOLUME=150000000
UNIVERSE_TIER_B_MIN_QUOTE_VOLUME=50000000
UNIVERSE_DEFAULT_HOT_BOOST=1.25
UNIVERSE_MAX_HOT_BOOST=1.5
UNIVERSE_DEFAULT_MIN_FUNDING_VOLUME=50000000
UNIVERSE_CHAOS_MIN_FUNDING_VOLUME=150000000
UNIVERSE_LOW_VOL_MIN_VOLUME_FLOOR=750000
UNIVERSE_CHAOS_HIGH_VOL_MIN_VOLUME_FLOOR=10000000
UNIVERSE_WEIGHT_LIQUIDITY_DEFAULT=0.65
UNIVERSE_WEIGHT_ACTIVITY_DEFAULT=0.20
UNIVERSE_WEIGHT_HOT_DEFAULT=0.15
UNIVERSE_WEIGHT_LIQUIDITY_ALT=0.55
UNIVERSE_WEIGHT_ACTIVITY_ALT=0.25
UNIVERSE_WEIGHT_HOT_ALT=0.20
UNIVERSE_WEIGHT_LIQUIDITY_COMPRESSION=0.60
UNIVERSE_WEIGHT_ACTIVITY_COMPRESSION=0.25
UNIVERSE_WEIGHT_HOT_COMPRESSION=0.15
UNIVERSE_WEIGHT_LIQUIDITY_RISK_OFF=0.75
UNIVERSE_WEIGHT_ACTIVITY_RISK_OFF=0.15
UNIVERSE_WEIGHT_HOT_RISK_OFF=0.10
UNIVERSE_WEIGHT_LIQUIDITY_CHAOS=0.80
UNIVERSE_WEIGHT_ACTIVITY_CHAOS=0.15
UNIVERSE_WEIGHT_HOT_CHAOS=0.05
UNIVERSE_WEIGHT_LIQUIDITY_LOW_VOL=0.70
UNIVERSE_WEIGHT_ACTIVITY_LOW_VOL=0.15
UNIVERSE_WEIGHT_HOT_LOW_VOL=0.15
UNIVERSE_WEIGHT_LIQUIDITY_DOMINANCE=0.72
UNIVERSE_WEIGHT_ACTIVITY_DOMINANCE=0.13
UNIVERSE_WEIGHT_HOT_DOMINANCE=0.15
STRATEGY_WATCH_COOLDOWN_MINUTES=30
STRATEGY_WATCH_DEDUP_PRICE_TOLERANCE_BPS=50
STRATEGY_EVALUATION_MIN_SAMPLE_WARNING=10
STRATEGY_EVALUATION_MIN_SAMPLE_MEDIUM=20
STRATEGY_EVALUATION_MIN_SAMPLE_HIGH=50
STRATEGY_MAX_MARKETDATA_PREFETCH_SYMBOLS=0
STRATEGY_SCAN_REQUEST_WEIGHT_BUDGET=0
STRATEGY_COMPRESSION_NEUTRAL_BREADTH_LOWER=0.35
STRATEGY_COMPRESSION_NEUTRAL_BREADTH_UPPER=0.65
STRATEGY_COMPRESSION_MAX_BB_WIDTH=0.10
STRATEGY_COMPRESSION_ZERO_ELIGIBLE_FALLBACK_THRESHOLD=2
STRATEGY_BROADER_VOLATILITY_SAMPLE_FLOOR=6
STRATEGY_FUNDING_EXTREME_THRESHOLD=0.003
STRATEGY_ATR_FALLBACK_PERCENT=0.01
STRATEGY_MIN_SL_ATR_MULTIPLIER_BASE=1.0
STRATEGY_MIN_SL_ATR_MULTIPLIER_REVERSAL=1.2
STRATEGY_MIN_SL_ATR_MULTIPLIER_HIGH_VOL=1.5
STRATEGY_ROTATION_ACTIVITY_THRESHOLD_DEFAULT=0.55
STRATEGY_ROTATION_ACTIVITY_THRESHOLD_ALT=0.45
STRATEGY_ROTATION_ACTIVITY_THRESHOLD_DEFENSIVE=0.65
STRATEGY_ROTATION_ACTIVITY_THRESHOLD_LOW_VOL=0.50
STRATEGY_ROTATION_PREFETCH_RATIO_DEFAULT=0.15
STRATEGY_ROTATION_PREFETCH_RATIO_ALT=0.20
STRATEGY_ROTATION_PREFETCH_RATIO_DEFENSIVE=0.10
STRATEGY_STALENESS_POLICY_SCALE_BASE=1.5
STRATEGY_STALENESS_POLICY_SCALE_MIN=0.50
STRATEGY_STALENESS_POLICY_SCALE_MAX=1.20
STRATEGY_STALENESS_LATE_THRESHOLD_MULTIPLIER=1.5
STRATEGY_STALENESS_BASE_PCT_CHAOS=0.20
STRATEGY_STALENESS_BASE_PCT_HIGH_VOL=0.50
STRATEGY_STALENESS_BASE_PCT_TIER_C=0.25
STRATEGY_STALENESS_BASE_PCT_DEFAULT=0.35
HOT_SOURCE_ENABLED=true
HOT_SOURCE_REQUEST_TIMEOUT_SECONDS=10
HOT_SOURCE_CACHE_TTL_SECONDS=600
HOT_SOURCE_TRENDING_CHAINS=1,56,8453
HOT_SOURCE_SOCIAL_HYPE_CHAINS=56,8453
HOT_SOURCE_SMART_MONEY_CHAINS=56,8453

# DEBUG
DEBUG_SAVE_RAW_KLINES=false
RAW_KLINES_DEBUG_DIR=debug/klines

# POCKETBASE (optional persistence for signal_journals + evaluation_runs)
POCKETBASE_ENABLED=false
POCKETBASE_URL=http://127.0.0.1:8090
# Choose exactly one auth method:
# 1) Static token
POCKETBASE_TOKEN=
# 2) Superuser login
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
# 3) Admin login (legacy PocketBase)
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
POCKETBASE_REQUEST_TIMEOUT_SECONDS=10
# Auto re-login attempts on 401/403 (0 disables, max 3)
POCKETBASE_LOGIN_RETRY_MAX=1

# STORAGE FILES
LATEST_RESULT_FILE=latest_result.json
SIGNAL_HISTORY_FILE=signal_history.json
SIGNAL_JOURNAL_FILE=signal_journal.json
AI_AUDIT_CACHE_FILE=ai_audit_cache.json
EVALUATION_REPORT_FILE=evaluation_report.json
DECISION_AUDIT_FILE=decision_audit.json
HEALTH_SNAPSHOT_FILE=health_snapshot.json

# SAFETY (CRITICAL: Do not weaken in production)
ALERT_ONLY=true
BINANCE_READ_ONLY=true
ALLOW_BINANCE_WRITE=false
DISABLE_BINANCE_ORDER_ENDPOINTS=true
DISABLE_AUTO_EXECUTION=true
DISABLE_AUTO_THRESHOLD_APPLY=true
REQUIRE_AI_HIGH_FOR_EXECUTE=true
REQUIRE_FRESH_ENTRY_FOR_EXECUTE=true
DECISION_AUDIT_ENABLED=true
HEALTH_STORAGE_CHECK=true

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json
LOG_INCLUDE_SCAN_ID=true

# ROUTE
API_PREFIX=/api/v3
ENABLE_DECISION_AUDIT_ENDPOINT=true
ENABLE_EVALUATION_RUN_ENDPOINT=true
SWAGGER_ENABLED=true
# Optional. If empty/unset, defaults to "localhost:${HTTP_PORT}".
SWAGGER_HOST=
SWAGGER_BASE_PATH=/api/v3
